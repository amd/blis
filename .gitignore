# -- generic files to ignore --

# emacs backup files
*~
# vim backup files
*.swp
# NFS file
.nfs*

# -- compiler-related --

# object files
# NOTE: This will result in git also exluding the top-level obj directory
# since its only contents are .o files.
*.o
# static library archives
# NOTE: This will result in git also exluding the top-level lib directory
# since its only contents are .a files.
*.a
*.so
*.so.*
# test executables
*.x
*.pexe
*.nexe
*.js
# link map files
*.map

# -- build system files --

config.mk
bli_config.h
bli_addon.h

# -- monolithic headers --

include/*/*.h

# -- makefile fragments --

.fragment.mk

# -- misc. --

# BLIS testsuite output file
output.testsuite*

# BLAS test output files
out.*

# GTAGS database
GPATH
GRTAGS
GTAGS

# cmake builds
build_*/*

# Windows build
bin/*
*.dll
*.lib
*.pdb
*.exe

# Visual Studio and VS Code files
.vs
.vscode*

# AI coding agent files
.aider*
.amazonq/
.claude*
.cline*
.codeium/
.codex*
.continue*
.copilot*
.github/copilot-instructions.md
.github/copilot/
.cursor*
.gemini*
.kilocode/
.mcp.json
.openhands/
.roo*
.trae/
.windsurf*
AGENTS.md
CLAUDE.local.md
CLAUDE.md
GEMINI.md

# Gtestsuite build files
gtestsuite/build/*

# -- local dev / analysis artifacts --

# clangd / tooling cache and compile database
.cache/
compile_commands.json

# preprocessor / macro-expansion dumps
*.expanded.c
*.preprocessed.c
